import java.util.*;
public class Main{
    public static int sumofEven(int n){
        int sum=0;
        while(n>0){
            int rem=n%10;
            if(rem%2==0){
                sum=sum+rem;
            }
            n/=10;
        }
        return sum;
    }
    public static void main (String[] args) {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int ans=sumofEven(n);
        System.out.println(ans);
    }
}
