     public static void main (String[] args) {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int ans=reverse(n);
        // boolean ans=ispalli(n);
        if(n==ans){
            System.out.println("Palindrome");
        }
        else {
            System.out.println("Not Palindrome");
        }
     }
}
